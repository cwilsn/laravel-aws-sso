{
    "name": "cwilsn/laravel-aws-sso",
    "description": "Seamless AWS IAM Identity Center authentication for local Laravel development.",
    "keywords": [
        "laravel",
        "aws",
        "aws-sso",
        "iam-identity-center",
        "sso",
        "development",
        "credentials"
    ],
    "homepage": "https://github.com/cwilsn/laravel-aws-sso",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Corey Wilson",
            "email": "corey@eastcodes.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.16",
        "illuminate/contracts": "^13.16",
        "illuminate/process": "^13.16",
        "illuminate/support": "^13.16",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/process": "^7.4.5 || ^8.0.5"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelAwsSso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelAwsSso\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelAwsSso\\LaravelAwsSsoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
